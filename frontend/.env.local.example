# URL base do backend FastAPI. Obrigatória para chegar ao navegador, por
# isso o prefixo NEXT_PUBLIC_ (não é segredo — nunca coloque uma chave
# secreta aqui ou em qualquer variável NEXT_PUBLIC_*).
NEXT_PUBLIC_MATHMASTER_API_URL=http://127.0.0.1:8000

# Depreciada (nome usado até o Sprint Frontend V1). Continua funcionando
# como fallback se NEXT_PUBLIC_MATHMASTER_API_URL não estiver definida,
# mas emite um aviso no console — migre e remova esta linha.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
